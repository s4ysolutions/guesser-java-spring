<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>s4y.guess</groupId>
  <artifactId>guess-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>guess-java</name>
  <description>Hexagonal architecture and DDD demo: the guessing game in Java.</description>

  <properties>
    <java.version>25</java.version>
  </properties>

  <!-- Top level folders: core, features, products. -->
  <modules>
    <module>core</module>
    <module>features</module>
    <module>products</module>
  </modules>

  <!-- All internal artifacts are listed here. Leaf modules do not write versions. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-core-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-core-infra-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-core-infra-spring-tx</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-infra-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-infra-longest-match</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-infra-jev</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-infra-h2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>s4y.guess</groupId>
        <artifactId>guess-guesser-presentation-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
