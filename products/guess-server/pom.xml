<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>s4y.guess</groupId>
    <artifactId>guess-products</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>guess-server</artifactId>
  <name>guess-server</name>
  <description>REST server of the guessing game. A composition root: it picks the adapters.</description>

  <dependencies>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-core-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-core-infra-spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-app</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-infra-h2</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-infra-longest-match</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-infra-jev</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-presentation-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
      <!-- No Mockito in this project: tests use real fake adapters (infra/memory). -->
      <exclusions>
        <exclusion><groupId>org.mockito</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <!-- No Mockito in this project: tests use real fake adapters (infra/memory). -->
      <exclusions>
        <exclusion><groupId>org.mockito</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-core-infra-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>s4y.guess</groupId>
      <artifactId>guess-guesser-infra-memory</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- The runnable jar is called target/guess-server.jar. -->
    <finalName>guess-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
